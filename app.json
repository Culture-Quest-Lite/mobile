{
  "expo": {
    "name": "Culture Quest Lite",
    "slug": "Culture_quest_lite_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2-app-icon-v2.png",
    "scheme": ["culturequestlitemobile", "culturequest"],
    "userInterfaceStyle": "automatic",
      "android": {
        "package": "com.anonymous.Culture_quest_lite_mobile",
        "icon": "./assets/images/logo2-app-icon-android-smaller.png",
        "adaptiveIcon": {
          "backgroundColor": "#FFFFFF",
          "foregroundImage": "./assets/images/logo2-adaptive-foreground-smaller.png"
        },
        "intentFilters": [
          {
            "autoVerify": true,
            "action": "VIEW",
            "data": {
              "host": "culturequest.app",
              "pathPrefix": "/join",
              "scheme": "https"
            },
            "category": ["BROWSABLE", "DEFAULT"]
          },
          {
            "autoVerify": true,
            "action": "VIEW",
            "data": {
              "host": "api.culturequestlite.com",
              "pathPrefix": "/api/v1/groups/join",
              "scheme": "https"
            },
            "category": ["BROWSABLE", "DEFAULT"]
          }
        ],
        "predictiveBackGestureEnabled": false
      },
      "ios": {
        "icon": "./assets/images/logo2-app-icon-v2.png",
        "associatedDomains": [
          "applinks:culturequest.app",
          "applinks:api.culturequestlite.com"
        ]
      },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-cleartext-traffic",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/logo2-splash-card.png",
          "imageWidth": 250,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Culture Quest truy cập vị trí của bạn để xác minh check-in gần hotspot."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Cho phép Culture Quest truy cập thư viện của bạn để thêm ảnh và video vào bài đánh giá hotspot."
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
